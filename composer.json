{
    "name": "ysocode/berry",
    "description": "Berry is easy, fast and extremely uncomplicated. Create and manage your routes",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuri Oliveira",
            "email": "yuri.oliveira@ysocode.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "YSOCode\\Berry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.24",
        "captainhook/captainhook": "^5.25",
        "captainhook/hook-installer": "^1.0",
        "ramsey/conventional-commits": "^1.6",
        "phpunit/phpunit": "^12.3",
        "rector/rector": "^2.1",
        "php-di/php-di": "^7.0"
    },
    "minimum-stability": "stable",
    "scripts": {
        "pint": "vendor/bin/pint",
        "pint:test": "@pint --test",
        "rector": "vendor/bin/rector",
        "rector:dry-run": "@rector --dry-run",
        "phpstan": "vendor/bin/phpstan",
        "phpstan:baseline": "@phpstan --generate-baseline",
        "test": "vendor/bin/phpunit",
        "test:coverage": "@test --coverage-html coverage",
        "test:watch": "@test --watch",
        "fix": [
            "@rector",
            "@pint"
        ]
    },
    "config": {
        "allow-plugins": {
            "captainhook/hook-installer": true
        }
    }
}